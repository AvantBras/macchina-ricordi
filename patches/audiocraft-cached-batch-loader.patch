+class TokenPoolLoader:
+    """Loader for a token pool: crops encoded once, then drawn again epoch after epoch.
+
+    The pool folder holds ``tokens.npy`` (int16 codes ``[P, K, T]``, memory-mapped), ``infos.pt`` (one
+    ``AudioInfo`` per crop, without tokens) and ``order.npy`` (crop indices, ``batch_size`` per update, epochs back to
+    back). It yields what `CachedBatchLoader` yields, so the solver's cached path consumes it unchanged, but stores
+    each crop once instead of once per epoch. Pools are written by macchina_ricordi's ``scripts/build_token_pool.py``.
+    """
+
+    def __init__(self, pool_folder: Path, batch_size: int, num_workers: int = 10, min_length: int = 1):
+        import numpy as np
+
+        # shortcut: one process only; under DDP each rank would need its own slice of an update's crops
+        assert flashy.distrib.world_size() == 1, "TokenPoolLoader does not support distributed training yet"
+        self.batch_size = batch_size
+        self.updates = min_length
+        self.tokens = np.load(pool_folder / "tokens.npy", mmap_mode="r")
+        self.order = np.load(pool_folder / "order.npy", mmap_mode="r")
+        self.infos = torch.load(pool_folder / "infos.pt", "cpu", weights_only=False)
+        self._current_epoch: tp.Optional[int] = None
+        self.sampler = None  # for compatibility with the regular DataLoader
+
+    def __len__(self):
+        return self.updates
+
+    def start_epoch(self, epoch: int):
+        self._current_epoch = epoch
+
+    def __iter__(self):
+        import copy
+        import numpy as np
+
+        assert self._current_epoch is not None
+        start = (self._current_epoch - 1) * self.updates * self.batch_size
+        if start + self.updates * self.batch_size > len(self.order):
+            built = len(self.order) // (self.updates * self.batch_size)
+            raise RuntimeError(f"The token pool holds batches for {built} epochs, not epoch {self._current_epoch}.")
+        for update in range(self.updates):
+            first = start + update * self.batch_size
+            infos = []
+            for index in self.order[first:first + self.batch_size]:
+                info = copy.copy(self.infos[index])
+                info.audio_tokens = torch.from_numpy(np.array(self.tokens[index]))
+                infos.append(info)
+            yield [infos]
